#  결측치 처리
#2025
# 1. 각 컬럼별 NA 개수 확인
na_cnt_2025 <- colSums(is.na(dfall_2025))
# 2. NA가 하나라도 있는 컬럼명 추출
cols_with_na <- names(na_cnt_2025[na_cnt_2025 > 0])
# 3. NA 포함 컬럼만 데이터에서 제거
df_cle_2025 <- dfall_2025 %>% select(-all_of(cols_with_na))
# 결과 확인
print(colnames(df_cle_2025))  # NA 포함 컬럼 제거 후 남은 컬럼명 출력
process_2025 <- c("cveTags", "cvssMetricV40", "cvssMetricV30", "cvssMetricV2")

df_cle_2025 <- df_cle_2025 %>%
  # 리스트형 컬럼 내 실제 NULL 제거
  mutate(across(all_of(process_2025), ~ ifelse(is.list(.),
                                                  map(., ~ discard(.x, is.null)), .))) %>%
  # 문자열 "NULL", "null"은 NA로 변환
  mutate(across(all_of(process_2025), ~ ifelse(. %in% c("NULL", "null"), NA, .)))
# NA 개수 확인
colSums(is.na(df_cle_2025[process_2025]))
# 1) cveTags가 리스트형 컬럼이라면 내부 NULL 제거
df_cle_2025 <- df_cle_2025 %>%
  mutate(cveTags = map(cveTags, ~ discard(.x, is.null)))
df_cle_2025 <- df_cle_2025 %>%
  mutate(cveTags = map(cveTags, ~ map(.x, ~ ifelse(. == "NULL", NA, .))))
colnames(df_cle_2025)


